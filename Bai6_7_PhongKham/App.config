<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    Doi "Data Source" cho dung may cai SQL Server:
      - SQL Express : Data Source=.\SQLEXPRESS
      - Instance ten khac: Data Source=.\TEN_INSTANCE
      - Mac dinh   : Data Source=.
    Ung dung se tu tao CSDL "ClinicDB" neu no chua ton tai.
  -->
  <connectionStrings>
    <add name="ClinicDB"
         connectionString="Data Source=.\MSSQLSERVER03;Initial Catalog=ClinicDB;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
